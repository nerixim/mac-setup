# Shared provider plugin cache. Without this, every module's `.terraform/`
# holds its own copy of each provider binary — 50+ modules across a repo runs
# to tens of GB. With it, Terraform downloads once and hard-links per module.
#
# The directory must already exist or Terraform ignores the setting; the
# `make terraform` target creates it.
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"
